# Frontend environment variables
# Copy to .env.local (for Vite dev) or set in Vercel dashboard → Settings → Environment Variables

# API base URL. In production on Vercel, leave this UNSET so the vercel.json
# rewrites route /api/* and /uploads/* to the backend. Set this to an absolute
# URL (e.g. https://api.ebookstore.com) only if you want to bypass Vercel
# rewrites and connect directly to the backend (requires CORS on the backend).
# VITE_API_BASE_URL=https://api.ebookstore.com